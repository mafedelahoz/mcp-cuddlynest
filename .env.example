CUDDLYNEST_DB_HOST=
CUDDLYNEST_DB_PORT=
CUDDLYNEST_DB_USER=
CUDDLYNEST_DB_PASSWORD=
CUDDLYNEST_DB_NAME=

# Serve a destination from the local cache for this many hours before
# re-reading the DB (default 6).
CUDDLYNEST_CACHE_MAX_AGE_HOURS=6

# Optional tuning (defaults shown):
# CUDDLYNEST_DB_TIMEOUT_MS=5000          # connect timeout
# CUDDLYNEST_DB_QUERY_TIMEOUT_MS=3000    # per-query MAX_EXECUTION_TIME
# CUDDLYNEST_CACHE_FILE=.cache/stays-cache.json
# CUDDLYNEST_FALLBACK_LOG=logs/db-fallback.log
