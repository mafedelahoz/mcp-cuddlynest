CUDDLYNEST_DB_HOST=
CUDDLYNEST_DB_PORT=
CUDDLYNEST_DB_USER=
CUDDLYNEST_DB_PASSWORD=
CUDDLYNEST_DB_NAME=

# Serve a destination from the local cache for this many hours before
# re-reading the DB (default 6).
CUDDLYNEST_CACHE_MAX_AGE_HOURS=6

# Optional tuning (defaults shown):
# CUDDLYNEST_DB_TIMEOUT_MS=5000          # connect timeout
# CUDDLYNEST_DB_QUERY_TIMEOUT_MS=3000    # per-query MAX_EXECUTION_TIME
# CUDDLYNEST_CACHE_FILE=.cache/stays-cache.json
# CUDDLYNEST_FALLBACK_LOG=logs/db-fallback.log


CUDDLYNEST_JWT_ISSUER_URL=
CUDDLYNEST_API_KEY=
# Availability WebSocket and the Origin its handshake requires.
# CUDDLYNEST_BE_AVAILABILITY_URL=
# CUDDLYNEST_BE_ORIGIN=https://www.cuddlynest.com
# CUDDLYNEST_BE_TIMEOUT_MS=25000

# Attractions shopping service (vertical "attractions", source "live" only).
# CUDDLYNEST_ATTRACTIONS_API_URL=
# CUDDLYNEST_ATTRACTIONS_SITE_URL=https://www.cuddlynest.com
# CUDDLYNEST_ATTRACTIONS_TIMEOUT_MS=20000
# Cache of live attractions searches, served to source "auto"/"db" (AO-10).
# CUDDLYNEST_ATTRACTIONS_CACHE_MAX_AGE_HOURS=24
# CUDDLYNEST_ATTRACTIONS_CACHE_REFRESH_INTERVAL_HOURS=12   # HTTP mode only
# CUDDLYNEST_ATTRACTIONS_CACHE_FILE=.cache/attractions-cache.json

# Flight search engine (vertical "flights", source "live" only).
# CUDDLYNEST_FLIGHTS_API_URL=
# CUDDLYNEST_FLIGHTS_TIMEOUT_MS=60000
# Cache of live flight searches, served to source "auto"/"db" (AO-9). No
# background refresh: refreshing fares would be a supplier search.
# CUDDLYNEST_FLIGHTS_CACHE_MAX_AGE_MINUTES=30
# CUDDLYNEST_FLIGHTS_CACHE_FILE=.cache/flights-cache.json

# Booking steps (hidden unless this is true). Stays Request to Book, attractions
# availability and flight price are live supplier calls (L2B); none takes card data.
# CUDDLYNEST_ENABLE_BOOKING_TOOLS=false
# Stays: Request to Book (uses the JWT above) returns the checkout link; the side
# widget gives the final price and confirm-booking the status. Defaults are
# staging; prod hosts drop the "staging-" prefix.
# CUDDLYNEST_REQUEST_TO_BOOK_API_URL=
# CUDDLYNEST_CHECKOUT_SIDE_WIDGET_API_URL=
# CUDDLYNEST_CHECKOUT_CONFIRM_BOOKING_API_URL=
# CUDDLYNEST_CHECKOUT_SITE_URL=          # staging.cuddlynest.com for staging APIs, else www
# CUDDLYNEST_REQUEST_TO_BOOK_TIMEOUT_MS=30000
# CUDDLYNEST_ATTRACTIONS_BOOKING_API_URL=
# CUDDLYNEST_ATTRACTIONS_BOOKING_TIMEOUT_MS=45000
# CUDDLYNEST_FLIGHTS_BOOKING_API_URL=
# CUDDLYNEST_FLIGHTS_BOOKING_TIMEOUT_MS=60000
