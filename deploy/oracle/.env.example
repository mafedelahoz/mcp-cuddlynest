# Copy to .env and fill in.

# The public hostname Caddy will get an HTTPS cert for.
# No domain? Use your VM's public IP with dashes + .sslip.io, e.g.
#   SITE_ADDRESS=203-0-113-45.sslip.io
SITE_ADDRESS=

# Which published version to run. Bump after each `npm publish`.
CUDDLYNEST_MCP_VERSION=0.2.0

# Optional. Set a long random string to require  Authorization: Bearer <token>
# on POST /mcp. Leave blank for an open endpoint (simpler for directory clients).
MCP_AUTH_TOKEN=

# Optional. Max ms to wait for a listing page's rooms to render.
CUDDLYNEST_SCRAPE_TIMEOUT_MS=35000
