# Automatic HTTPS. {$SITE_ADDRESS} comes from the environment (see .env).
# With an <ip>.sslip.io address Caddy gets a real Let's Encrypt cert with no
# DNS setup. Swap for mcp.cuddlynest.com once a CNAME/A record exists.
#
# `handle` blocks are mutually exclusive and matched in order — first match
# wins — so /health and /mcp proxy through and everything else gets the stub.
{$SITE_ADDRESS} {
	encode zstd gzip

	handle /health {
		reverse_proxy mcp:8080
	}

	handle /mcp* {
		reverse_proxy mcp:8080
	}

	handle {
		respond "cuddlynest-mcp" 200
	}
}
